# Điền API Key của Google AI Studio để kích hoạt Gemini 3.8 Flash + Function Calling ở Bước 5.
# Nếu để trống, Server vẫn hoạt động bình thường với bộ xử lý Rule-based nội bộ.
GEMINI_API_KEY=your_gemini_api_key_here

# --- DxAI (ưu tiên hơn Gemini khi có DXAI_API_KEY) ---
# Khóa dạng dxai_{tenant}_{prefix}_{secret}, scope ai.run, tạo ở DxAI > Quản trị > Khóa API (workspace BOT TEAM).
DXAI_API_KEY=
DXAI_BASE_URL=https://demo.indus.nois.vn
DXAI_TENANT=nois
DXAI_AGENT_CODE=autobot-assistant
